# Server Configuration
NODE_ENV=development
PORT=4466

# Required in production. Used for future credential encryption and app secrets.
APP_SECRET=change-me-to-a-random-32-character-minimum-secret

# CORS Configuration
# Comma-separated when you need multiple allowed web origins.
CORS_ORIGIN=http://localhost:4366,http://localhost:4367

# Data Directory
DATA_DIR=./data

# Web Configuration
VITE_API_URL=http://localhost:4466
